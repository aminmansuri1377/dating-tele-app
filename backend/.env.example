# --- Core ---
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/dating_app?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Telegram ---
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."

# --- Storage (Cloudflare R2 or AWS S3) ---
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="dating-app-photos"
S3_PUBLIC_BASE_URL="https://cdn.yourdomain.com"

# --- Redis (rate limiting cache, presence, discovery cache) ---
REDIS_URL="redis://localhost:6379"

# --- TON ---
TON_RPC_ENDPOINT="https://toncenter.com/api/v2/jsonRPC"
TON_API_KEY=""
TON_MERCHANT_WALLET_ADDRESS="UQ..."
